struct('Controls', {
 construct(type) {
  def forward = 0;
  def left = 0;
  def right = 0;
  def reverse = 0;

  $.opt(type, {
   default: x => x,
   KEYS: x => this.$listeners(),
   DUMMY: x => this.forward = 1,
  })();
 },

 $listeners() {
  with(this) {
   listener('keydown', e => {
    $.opt(e.key, {
     default: x => x,
     ArrowLeft() {
      def left = 1;
     },
     
     ArrowRight() {
      def right = 1;
     },
     
     ArrowUp() {
      def forward = 1;
     },
     
     ArrowDown() {
      def reverse = 1;
     },
    }).bind(this)();
   })
   
   listener('keyup', e => {
    $.opt(e.key, {
     default: x => x,
     ArrowLeft() {
      def left = 0;
     },
     
     ArrowRight() {
      def right = 0;
     },
     
     ArrowUp() {
      def forward = 0;
     },
     
     ArrowDown() {
      def reverse = 0;
     },
    }).bind(this)();
   })
  }
 },
})